{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pen-probe",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tools/pen-probe/serve.ps1"],
      "port": 8765
    },
    {
      "name": "analytics",
      "runtimeExecutable": "services/analytics/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "ilt_analytics.main:app", "--app-dir", "services/analytics", "--host", "127.0.0.1", "--port", "8090", "--reload", "--reload-dir", "services/analytics/ilt_analytics", "--timeout-graceful-shutdown", "3"],
      "port": 8090
    },
    {
      "name": "gateway",
      "runtimeExecutable": "pnpm.cmd",
      "runtimeArgs": ["--filter", "@ilt/telemetry-gateway", "dev"],
      "port": 8080
    },
    {
      "name": "tablet-kiosk",
      "runtimeExecutable": "pnpm.cmd",
      "runtimeArgs": ["--filter", "@ilt/tablet-kiosk", "dev"],
      "port": 5173
    },
    {
      "name": "evaluator-cockpit",
      "runtimeExecutable": "pnpm.cmd",
      "runtimeArgs": ["--filter", "@ilt/evaluator-cockpit", "dev"],
      "port": 5174
    },
    {
      "name": "tablet-kiosk-lan",
      "runtimeExecutable": "pnpm.cmd",
      "runtimeArgs": ["--filter", "@ilt/tablet-kiosk", "dev:lan"],
      "port": 5173,
      "url": "https://localhost:5173"
    },
    {
      "name": "evaluator-cockpit-lan",
      "runtimeExecutable": "pnpm.cmd",
      "runtimeArgs": ["--filter", "@ilt/evaluator-cockpit", "dev:lan"],
      "port": 5174,
      "url": "https://localhost:5174"
    },
    {
      "name": "evaluator-cockpit-check",
      "runtimeExecutable": "pnpm.cmd",
      "runtimeArgs": ["--filter", "@ilt/evaluator-cockpit", "exec", "vite", "--port", "5176", "--strictPort"],
      "port": 5176
    },
    {
      "name": "tablet-kiosk-check",
      "runtimeExecutable": "pnpm.cmd",
      "runtimeArgs": ["--filter", "@ilt/tablet-kiosk", "exec", "vite", "--port", "5177", "--strictPort"],
      "port": 5177
    },
    {
      "name": "analyst-portal-check",
      "runtimeExecutable": "pnpm.cmd",
      "runtimeArgs": ["--filter", "@ilt/analyst-portal", "exec", "vite", "--port", "5178", "--strictPort"],
      "port": 5178
    },
    {
      "name": "analyst-portal-lan",
      "runtimeExecutable": "pnpm.cmd",
      "runtimeArgs": ["--filter", "@ilt/analyst-portal", "dev:lan"],
      "port": 5175,
      "url": "https://localhost:5175"
    },
    {
      "name": "analyst-portal",
      "runtimeExecutable": "pnpm.cmd",
      "runtimeArgs": ["--filter", "@ilt/analyst-portal", "dev"],
      "port": 5175
    }
  ]
}

# ILT cloud install: settings for the app VMs and the analytics VM (copy to ilt.env, chmod 600).
# Never commit ilt.env. Generate secrets with:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# --- Hostnames (one DNS A record each, pointing at the VM that serves it) ---
ACME_EMAIL=it-admin@example.org
# App VM: the four cells it hosts (VM 1: c1-c4, VM 2: c5-c8, VM 3: c9-c12)
CELL_1_HOST=c1.ilt.example.org
CELL_2_HOST=c2.ilt.example.org
CELL_3_HOST=c3.ilt.example.org
CELL_4_HOST=c4.ilt.example.org
# Analytics VM
ANALYST_HOST=research.ilt.example.org

# --- Gateway ---
GATEWAY_PORT=8080
LOG_LEVEL=info
# Same value on every VM (tokens are checked by any cell). Changing it logs everybody out.
JWT_SECRET=
# Same value on every VM. NEVER change it after the first participant is registered:
# school codes are stored as HMACs with this key and could no longer be matched.
SCHOOL_CODE_HMAC_KEY=
# The application role (ilt_app) on the PRIMARY database
APP_DATABASE_URL=postgres://ilt_app:<ILT_APP_DB_PASSWORD>@10.20.1.10:5432/ilt

# --- S3 storage (SeaweedFS on the database primary) ---
S3_ENDPOINT=http://10.20.1.10:8333
S3_ACCESS_KEY=ilt-s3
S3_SECRET_KEY=

# --- Analytics VM only: the analyst role on the READ REPLICA ---
ANALYTICS_DATABASE_URL=postgres://ilt_analyst:<ILT_ANALYST_DB_PASSWORD>@10.20.1.11:5432/ilt

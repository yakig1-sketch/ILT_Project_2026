# ILT database VMs (copy to .env next to compose.db.yml, chmod 600). Never commit it.
# Private address of THIS VM (the ports bind to it only)
DB_BIND_IP=10.20.1.10
POSTGRES_USER=ilt_owner
POSTGRES_PASSWORD=
POSTGRES_DB=ilt
PG_DATA_DIR=/data/pg

# Tuning for 16 vCPU / 64 GB RAM (Installation Guide §2.2). Scale with the VM size.
PG_SHARED_BUFFERS=16GB
PG_EFFECTIVE_CACHE_SIZE=48GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=2GB
PG_MAX_WAL_SIZE=32GB
PG_SHM_SIZE=8g
PG_MAX_CONNECTIONS=300

# Primary only: SeaweedFS S3 storage
S3_DATA_DIR=/data/s3
S3_ACCESS_KEY=ilt-s3
S3_SECRET_KEY=

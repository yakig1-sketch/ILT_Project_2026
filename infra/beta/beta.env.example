# ILT beta stack secrets (Phase 6b′). Copy to beta.env in this folder and fill in every empty value.
# Never commit beta.env (it is in .gitignore).
# Use letters and digits only (no symbols): the passwords go into database URLs. A good value in
# PowerShell, 64 characters:  [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')

# Image tag: the git tag being run (beta-1, beta-2, ...). Shown in the image names only.
BETA_TAG=beta-1
# The web front, on 127.0.0.1 only. The Cloudflare Tunnel route points here (http://localhost:8088).
BETA_PORT=8088

# Database owner (migrations and seed only) and the two service roles.
POSTGRES_PASSWORD=
ILT_APP_DB_PASSWORD=
ILT_ANALYST_DB_PASSWORD=

# Object storage (pen data, videos, exports).
S3_ACCESS_KEY=ilt-s3
S3_SECRET_KEY=

# Gateway. Changing JWT_SECRET signs everybody out. NEVER change SCHOOL_CODE_HMAC_KEY once a
# participant is registered: school codes are stored as HMACs with it.
JWT_SECRET=
SCHOOL_CODE_HMAC_KEY=

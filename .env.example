# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=ilt_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=ilt
DATABASE_URL=postgres://ilt_owner:change-me-owner@localhost:5432/ilt

S3_ACCESS_KEY=ilt-s3
S3_SECRET_KEY=change-me-s3
S3_ENDPOINT=http://localhost:8333

# Gateway
GATEWAY_PORT=8080
JWT_SECRET=change-me-long-random-string
SCHOOL_CODE_HMAC_KEY=change-me-long-random-string

# Dev seed only (never used in production)
SEED_DEV_PASSWORD=change-me-dev
SEED_DIRECTOR_PIN=246810

# Database roles used by the services (created by the migrations, passwords set by `pnpm db:migrate`)
ILT_APP_DB_PASSWORD=change-me-app
ILT_ANALYST_DB_PASSWORD=change-me-analyst
APP_DATABASE_URL=postgres://ilt_app:change-me-app@localhost:5432/ilt
